# Copy to .env (never commit it) and load with:  set -a; source .env; set +a
# Create keys in the Trading 212 app: Settings > API (Beta).
# Use separate keys for the demo (practice) and live accounts.
T212_API_KEY_DEMO=
T212_API_SECRET_DEMO=
T212_API_KEY_LIVE=
T212_API_SECRET_LIVE=
# Live orders are refused unless this is exactly "yes".
T212_ALLOW_LIVE=no
